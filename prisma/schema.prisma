generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") directUrl = env("DIRECT_URL") }

enum Role { SUPER_ADMIN SHOP_OWNER CUSTOMER }
enum SubscriptionStatus { ACTIVE EXPIRED CANCELLED }
enum AddressLabel { HOME OFFICE }
enum PaystackMode { PLATFORM_ACCOUNT OWN_PAYSTACK }
enum OrderStatus { PENDING_PAYMENT PAID PROCESSING SHIPPED DELIVERED CANCELLED DISPUTED }
enum ProductSource { NATIVE JUMIA AMAZON }
enum PayoutStatus { PENDING APPROVED PAID }
enum MessageDirection { IN OUT }
enum MessageStatus { SENT DELIVERED READ FAILED }

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String @unique
  passwordHash String
  role Role @default(CUSTOMER)
  avatarUrl String?
  createdAt DateTime @default(now())
  subscriptionStatus SubscriptionStatus @default(EXPIRED)
  paystackCustomerCode String?
  balance Decimal @default(0) @db.Decimal(14,2)
  addresses Address[]
  shops Shop[]
  orders Order[]
  subscriptions Subscription[]
  reviews Review[]
}

model Address {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  label AddressLabel
  region String
  city String
  district String
  digitalAddress String
  street String
  phone2 String?
  isDefault Boolean @default(false)
  deliveryInstructions String?
  @@index([userId])
}

model Shop {
  id String @id @default(cuid())
  ownerId String @unique
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String
  slug String @unique
  description String
  category String
  logoUrl String?
  bannerUrl String?
  rating Float @default(0)
  followers Int @default(0)
  isVerified Boolean @default(false)
  isActive Boolean @default(true)
  commissionRate Float @default(10)
  paystackMode PaystackMode @default(PLATFORM_ACCOUNT)
  paystackSubaccountCode String?
  paystackBankVerified Boolean @default(false)
  whatsappConnected Boolean @default(false)
  subscriptionPlanId String?
  subscriptionExpiresAt DateTime?
  impressionCount Int @default(0)
  lastShownAt DateTime?
  products Product[]
  orders Order[]
  conversations WhatsappConversation[]
  messages WhatsappMessage[]
  payouts Payout[]
  @@index([slug])
}

model Product {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title String
  slug String
  description String
  price Decimal @db.Decimal(14,2)
  compareAtPrice Decimal? @db.Decimal(14,2)
  discountPercent Int @default(0)
  stock Int @default(0)
  sku String @unique
  category String
  brand String?
  images String[]
  rating Float @default(0)
  reviewCount Int @default(0)
  source ProductSource @default(NATIVE)
  affiliateLink String?
  externalId String?
  isFeatured Boolean @default(false)
  seoTitle String?
  seoDesc String?
  impressionCount Int @default(0)
  lastShownAt DateTime @default(now())
  createdAt DateTime @default(now())
  reviews Review[]
  @@unique([shopId, slug])
  @@index([shopId, category])
  @@index([source])
}

model Order {
  id String @id @default(cuid())
  customerId String
  customer User @relation(fields: [customerId], references: [id])
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  orderNumber String @unique
  status OrderStatus @default(PENDING_PAYMENT)
  total Decimal @db.Decimal(14,2)
  subtotal Decimal @db.Decimal(14,2)
  deliveryFee Decimal @db.Decimal(14,2)
  items Json
  customerPhone String
  shippingAddressId String
  paystackReference String @unique
  paystackSplit Json?
  whatsappConversationId String?
  createdAt DateTime @default(now())
  @@index([shopId, status])
  @@index([customerId, createdAt])
}

model SubscriptionPlan {
  id String @id @default(cuid())
  name String
  priceGHS Decimal @db.Decimal(12,2)
  productLimit Int
  features String[]
  paystackPlanCode String @unique
  interval String @default("monthly")
  subscriptions Subscription[]
}

model Subscription {
  id String @id @default(cuid())
  userId String
  planId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
  status SubscriptionStatus @default(ACTIVE)
  paystackSubscriptionCode String @unique
  currentPeriodStart DateTime
  currentPeriodEnd DateTime
  createdAt DateTime @default(now())
  @@index([userId, status])
}

model WhatsappConversation {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerPhone String
  customerName String?
  lastMessageAt DateTime @default(now())
  unreadCount Int @default(0)
  messages WhatsappMessage[]
  @@index([shopId])
  @@index([customerPhone])
}

model WhatsappMessage {
  id String @id @default(cuid())
  conversationId String
  shopId String
  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  direction MessageDirection
  body String
  templateName String?
  status MessageStatus @default(SENT)
  paystackLink String?
  orderId String?
  createdAt DateTime @default(now())
  @@index([shopId, createdAt])
  @@index([conversationId, createdAt])
}

model Review {
  id String @id @default(cuid())
  productId String
  userId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating Int
  comment String
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
}

model Payout {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  amount Decimal @db.Decimal(14,2)
  status PayoutStatus @default(PENDING)
  periodStart DateTime
  periodEnd DateTime
  paystackTransferCode String?
  @@index([shopId, status])
}
